+    /** where each part's tab goes: under its box (over it at the bottom of the screen), clear of the others */
+    private void layoutHudTabs() {
+        paint.setTextSize(13);
+        for (int part = 0; part < HUD_PARTS; part++) {
+            int at = part * 4;
+            if (!hudKnown(part)) {
+                hudTabs[at] = Float.NaN;
+                continue;
+            }
+            float left = hudLeft(part);
+            float top = hudTop(part);
+            float width = hudWidth(part);
+            float height = hudHeight(part);
+            float tabWidth = Math.max(70, paint.measureText(HUD_NAMES[part]) + 28);
+            float tabTop = top + height + HUD_TAB_GAP;
+            if (tabTop + HUD_TAB_HEIGHT > logicalHeight)
+                tabTop = top - HUD_TAB_GAP - HUD_TAB_HEIGHT;
+            tabTop = Math.max(0, Math.min(logicalHeight - HUD_TAB_HEIGHT, tabTop));
+            float tabLeft = Math.max(0, Math.min(logicalWidth - tabWidth, left + width / 2 - tabWidth / 2));
+            // (shield and health are drawn together: their tabs go side by side)
+            for (int tries = 0; tries < HUD_PARTS * 2; tries++) {
+                boolean clear = true;
+                for (int other = 0; other < part; other++) {
+                    int o = other * 4;
+                    if (Float.isNaN(hudTabs[o]) || tabLeft >= hudTabs[o + 2] + 4 || tabLeft + tabWidth + 4 <= hudTabs[o]
+                            || tabTop >= hudTabs[o + 3] || tabTop + HUD_TAB_HEIGHT <= hudTabs[o + 1])
+                        continue;
+                    clear = false;
+                    tabLeft = hudTabs[o + 2] + 4;
+                    if (tabLeft + tabWidth > logicalWidth)
+                        tabLeft = Math.max(0, hudTabs[o] - 4 - tabWidth);
+                }
+                if (clear)
