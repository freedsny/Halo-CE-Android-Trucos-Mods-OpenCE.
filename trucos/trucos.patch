+/* port: the powerups and the vehicles of the globals tag's lists, and when
+the map's globals tag has none (the campaign's, often) every powerup (equipment)
+or vehicle tag of the map, as cheat_all_weapons does with the weapons */
+static void cheat_objects(
+	struct tag_reference *references,
+	short reference_count);
+static long cheat_player_index(
+	void);
+
+static void cheat_all_of_group(
+	unsigned long group)
+{
+	struct tag_reference references[MAXIMUM_CHEATS];
+	struct tag_iterator iterator;
+	long tag_index;
+	short reference_count = 0;
+
+	tag_iterator_new(&iterator, group);
+	for (tag_index = tag_iterator_next(&iterator);
+		tag_index!=NONE && reference_count<NUMBEROF(references);
+		tag_index = tag_iterator_next(&iterator))
+	{
+		references[reference_count].index = tag_index;
+		reference_count++;
+	}
+
+	cheat_objects(references, reference_count);
+
+	return;
+}
+
+static void cheat_port_all_powerups(
+	void)
+{
+	struct game_globals *globals = scenario_get_game_globals();
+
+	if (TAG_BLOCK_TRY_AND_GET_ELEMENT(&globals->cheat_powerups, 0, struct tag_reference))
+	{
+		cheat_all_powerups();
+	}
+	else
+	{
+		cheat_all_of_group(EQUIPMENT_DEFINITION_TAG);
+	}
+
+	return;
+}
+
+/* port: the objects around the player in a ring that grows with their number,
+`spacing` apart (the vehicles are big: cheat_objects' 1.5 world units ring puts
+them one on another) */
+#define MAXIMUM_CHEAT_VEHICLES 48
+
+static void cheat_objects_spread(
+	struct tag_reference *references,
+	short reference_count,
+	real spacing,
+	real minimum_radius)
+{
+	long player_index = cheat_player_index();
+
+	if (player_index!=NONE && reference_count>0)
+	{
+		struct player_datum *player = player_get(player_index);
+		real_point3d origin;
+		real_vector3d forward, up;
+		real radius = reference_count*spacing/(2*_pi);
+		real start_angle;
+		short reference_index;
+
+		if (radius<minimum_radius)
+		{
+			radius = minimum_radius;
+		}
+
+		object_get_origin(player->unit_index, &origin);
+		object_get_orientation(player->unit_index, &forward, &up);
+		start_angle = arctangent(forward.i, forward.j);
+
+		for (reference_index = 0; reference_index<reference_count; reference_index++)
+		{
+			if (references[reference_index].index!=NONE)
+			{
+				struct object_placement_data data;
+				real angle = start_angle + reference_index*(2*_pi/reference_count);
+
+				object_placement_data_new(&data, references[reference_index].index, NONE);
+
+				data.position.x = cosine(angle)*radius+origin.x;
+				data.position.y = sine(angle)*radius+origin.y;
+				data.position.z = origin.z+0.8f;
+				data.forward = forward;
+				data.up = up;
+
+				object_new(&data);
+			}
+		}
+	}
+
+	return;
+}
+
+static void cheat_port_all_vehicles(
+	void)
+{
+	struct game_globals *globals = scenario_get_game_globals();
+	struct tag_reference references[MAXIMUM_CHEAT_VEHICLES];
+	short reference_count = 0;
+
+	if (globals->multiplayer_information.count > 0 && globals->multiplayer_information.address)
+	{
+		struct game_globals_multiplayer_information *information =
+			TAG_BLOCK_GET_ELEMENT(&globals->multiplayer_information, 0,
+				struct game_globals_multiplayer_information);
+		short index;
+
+		for (index = 0; index<information->vehicles.count && reference_count<MAXIMUM_CHEAT_VEHICLES; index++)
+		{
+			struct tag_reference *reference = TAG_BLOCK_TRY_AND_GET_ELEMENT(&information->vehicles, index, struct tag_reference);
+
+			if (reference && reference->index!=NONE)
+			{
+				references[reference_count++] = *reference;
+			}
+		}
+	}
+
+	if (reference_count==0)
+	{
+		struct tag_iterator iterator;
+		long tag_index;
+
+		tag_iterator_new(&iterator, VEHICLE_DEFINITION_TAG);
+		for (tag_index = tag_iterator_next(&iterator);
+			tag_index!=NONE && reference_count<MAXIMUM_CHEAT_VEHICLES;
+			tag_index = tag_iterator_next(&iterator))
+		{
+			references[reference_count].index = tag_index;
+			reference_count++;
+		}
+	}
+
+	cheat_objects_spread(references, reference_count, 8.0f, 6.0f);
+
+	return;
+}
