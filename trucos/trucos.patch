+        float height = hudHeight(part);
+        left = Math.max(HUD_KEEP_VISIBLE - width, Math.min(logicalWidth - HUD_KEEP_VISIBLE, left));
+        top = Math.max(HUD_KEEP_VISIBLE - height, Math.min(logicalHeight - HUD_KEEP_VISIBLE, top));
