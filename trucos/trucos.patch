+            float top = hudTop(part);
+            float width = hudWidth(part);
+            float height = hudHeight(part);
+            if (x >= left && x <= left + width && y >= top && y <= top + height && width * height < area) {
+                found = HUD_PART - part;
+                area = width * height;
+            }
+        }
+        return found;
+    }
