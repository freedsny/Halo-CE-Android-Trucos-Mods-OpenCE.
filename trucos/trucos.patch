+/* port: where the player has moved the parts of the HUD (settings, TRUCOS, HUD):
+hud.<part>_x and hud.<part>_y plus the fine ones, hud.<part>_fx and hud.<part>_fy, in HUD
+units, read again when a setting changes.
+They move the part whatever corner it is anchored to: positive x is right and
+positive y is down */
+long config_integer(const char *name);
+unsigned long config_changes(void);
+
+short hud_port_part = _hud_port_part_none;
+/* the editor's move of each part while a finger drags it, in HUD units, shown
+before it is saved (hud_port_offset adds it; the rectangles leave it out) */
+static real hud_port_preview[NUMBER_OF_HUD_PORT_PARTS][2];
+
+static real hud_port_offset(
+	short part,
+	short axis)
+{
+	static char const *const names[NUMBER_OF_HUD_PORT_PARTS][4] =
+	{
+		{ NULL, NULL, NULL, NULL },
+		{ "hud.shield_x", "hud.shield_y", "hud.shield_fx", "hud.shield_fy" },
+		{ "hud.health_x", "hud.health_y", "hud.health_fx", "hud.health_fy" },
+		{ "hud.radar_x", "hud.radar_y", "hud.radar_fx", "hud.radar_fy" },
+		{ "hud.ammo_x", "hud.ammo_y", "hud.ammo_fx", "hud.ammo_fy" },
+		{ "hud.grenades_x", "hud.grenades_y", "hud.grenades_fx", "hud.grenades_fy" },
+	};
+	static real offsets[NUMBER_OF_HUD_PORT_PARTS][2];
+	static unsigned long changes = 0;
+	static boolean read = FALSE;
+	real result = 0.0f;
+
+	if (part>0 && part<NUMBER_OF_HUD_PORT_PARTS && axis>=0 && axis<2)
+	{
+		if (!read || changes!=config_changes())
+		{
+			short part_index, axis_index;
+
+			read = TRUE;
+			changes = config_changes();
+			for (part_index = 1; part_index<NUMBER_OF_HUD_PORT_PARTS; part_index++)
+			{
+				for (axis_index = 0; axis_index<2; axis_index++)
+				{
+					long value = config_integer(names[part_index][axis_index])+
+						config_integer(names[part_index][axis_index+2]);
+
+					offsets[part_index][axis_index] = (real)PIN(value, -2000, 2000);
+				}
+			}
+		}
+		result = offsets[part][axis]+hud_port_preview[part][axis];
+	}
+
+	return result;
+}
+
+/* port: where each movable part was drawn, for the touch controls' editor,
+which moves them with a finger (port/linux/src/touch_input.c): the bounds of
+this frame's pictures of each part in the view's pixels, and the last frame's
+as fractions of the view, kept while a part is not drawn. Only with one local
+player; a picture as big as half the view (a scope's mask) is left out */
+static real hud_port_frame_bounds[NUMBER_OF_HUD_PORT_PARTS][4];
+static boolean hud_port_frame_drawn[NUMBER_OF_HUD_PORT_PARTS];
+static float hud_port_rects[NUMBER_OF_HUD_PORT_PARTS][4];
+static boolean hud_port_rects_known[NUMBER_OF_HUD_PORT_PARTS];
+static float hud_port_view_units[2];
+
+static void hud_port_note_quad(
+	struct dynamic_screen_vertex const *vertices)
+{
+	real width = (real)(render.camera.viewport_bounds.x1 - render.camera.viewport_bounds.x0);
+	real height = (real)(render.camera.viewport_bounds.y1 - render.camera.viewport_bounds.y0);
+	real x0 = vertices[0].position.x, x1 = x0, y0 = vertices[0].position.y, y1 = y0;
+	real *bounds;
+	short vertex_index;
+
+	if (hud_port_part<=_hud_port_part_none || hud_port_part>=NUMBER_OF_HUD_PORT_PARTS ||
+		local_player_count()!=1 || width<=0.0f || height<=0.0f)
+	{
+		return;
+	}
+	for (vertex_index = 1; vertex_index<4; vertex_index++)
+	{
+		x0 = MIN(x0, vertices[vertex_index].position.x);
+		x1 = MAX(x1, vertices[vertex_index].position.x);
+		y0 = MIN(y0, vertices[vertex_index].position.y);
+		y1 = MAX(y1, vertices[vertex_index].position.y);
+	}
+	if (x1-x0>width*0.5f || y1-y0>height*0.5f || x1<=x0 || y1<=y0)
+		return;
+	bounds = hud_port_frame_bounds[hud_port_part];
+	if (!hud_port_frame_drawn[hud_port_part])
+	{
+		bounds[0] = x0;
+		bounds[1] = y0;
+		bounds[2] = x1;
+		bounds[3] = y1;
+		hud_port_frame_drawn[hud_port_part] = TRUE;
+	}
+	else
+	{
+		bounds[0] = MIN(bounds[0], x0);
+		bounds[1] = MIN(bounds[1], y0);
+		bounds[2] = MAX(bounds[2], x1);
+		bounds[3] = MAX(bounds[3], y1);
+	}
+}
+
+/* (hud.c's hud_draw_screen, around a view's HUD) */
+void hud_port_frame_begin(
+	void)
+{
+	short part;
+
+	for (part = 0; part<NUMBER_OF_HUD_PORT_PARTS; part++)
+		hud_port_frame_drawn[part] = FALSE;
+}
+
+void hud_port_frame_end(
+	void)
+{
+	real width = (real)(render.camera.viewport_bounds.x1 - render.camera.viewport_bounds.x0);
+	real height = (real)(render.camera.viewport_bounds.y1 - render.camera.viewport_bounds.y0);
+	real scale = hud_globals_get_scale(FALSE);
+	short part;
+
+	if (local_player_count()!=1 || width<=0.0f || height<=0.0f || scale<=0.0f)
+		return;
+	for (part = 1; part<NUMBER_OF_HUD_PORT_PARTS; part++)
+	{
+		if (hud_port_frame_drawn[part])
+		{
+			real preview_x = hud_port_preview[part][0]*scale;
+			real preview_y = hud_port_preview[part][1]*scale;
+
+			hud_port_rects[part][0] = (hud_port_frame_bounds[part][0]-preview_x)/width;
+			hud_port_rects[part][1] = (hud_port_frame_bounds[part][1]-preview_y)/height;
+			hud_port_rects[part][2] = (hud_port_frame_bounds[part][2]-preview_x)/width;
+			hud_port_rects[part][3] = (hud_port_frame_bounds[part][3]-preview_y)/height;
+			hud_port_rects_known[part] = TRUE;
+		}
+	}
+	hud_port_view_units[0] = width/scale;
+	hud_port_view_units[1] = height/scale;
+}
+
+/* the parts' rectangles, from the shield (hud_draw.h's order without none),
+into rects[4 * 5] as fractions of the view (left, top, right, bottom; all -1
+for a part not drawn yet), and the view's size in HUD units into
+view_units[2]; returns FALSE until the HUD has been drawn */
+boolean hud_port_touch_rects(
+	float *rects,
+	float *view_units)
+{
+	short part;
+	short index;
+
+	for (part = 1; part<NUMBER_OF_HUD_PORT_PARTS; part++)
+	{
+		for (index = 0; index<4; index++)
+			rects[(part-1)*4+index] = hud_port_rects_known[part] ? hud_port_rects[part][index] : -1.0f;
+	}
+	view_units[0] = hud_port_view_units[0];
+	view_units[1] = hud_port_view_units[1];
+
+	return hud_port_view_units[0]>0.0f;
+}
+
+/* where the editor's finger has a part, in HUD units from where its settings
+put it: 0 when not dragged */
+void hud_port_touch_preview(
+	short part,
+	float x,
+	float y)
+{
+	if (part>0 && part<NUMBER_OF_HUD_PORT_PARTS)
+	{
+		hud_port_preview[part][0] = x;
+		hud_port_preview[part][1] = y;
+	}
+}
+
+/* a part moved by the editor, by fractions of the view, until it is drawn
+again where its settings now put it */
+void hud_port_touch_shift(
+	short part,
+	float x,
+	float y)
+{
+	if (part>0 && part<NUMBER_OF_HUD_PORT_PARTS && hud_port_rects_known[part])
+	{
+		hud_port_rects[part][0] += x;
+		hud_port_rects[part][2] += x;
+		hud_port_rects[part][1] += y;
+		hud_port_rects[part][3] += y;
+	}
+}
+
+/* ---------- port: the radar's sweep (TRUCOS, HUD: RADAR, hud.radar_sweep)
+
+Over the motion sensor, in light blue: a sweep turning once every three
+seconds, a cross and two rings. The shapes are plain quads of the white bitmap
+of the maps' default textures (the one the cinematics' letterbox is drawn
+with), tinted by their corners' colors. Sizes are in the HUD's units (the
+tags' 640x480). */
+
+int config_boolean(const char *name);
+
+#define HUD_PORT_ACCENT 0x7FCFFF
+
+static pixel32 hud_port_color(
+	real alpha,
+	pixel32 rgb)
+{
+	return ((pixel32)PIN(fast_ftol_C(alpha*255.0f), 0, 255)<<24) | (rgb & 0x00FFFFFF);
+}
+
+/* the white bitmap of the maps' default 2D textures (multiplicative: white) */
+static struct bitmap_data *hud_port_white_bitmap(
+	void)
+{
+	struct game_globals *game_globals = scenario_get_game_globals();
+	struct game_globals_rasterizer_data *rasterizer_data;
+	long group_index;
+
+	if (!game_globals || game_globals->rasterizer_data.count<1)
+		return NULL;
+	rasterizer_data = TAG_BLOCK_GET_ELEMENT(&game_globals->rasterizer_data, 0, struct game_globals_rasterizer_data);
+	group_index = rasterizer_data->default_textures[0].index;
+	if (group_index==NONE)
+		return NULL;
+
+	return bitmap_group_try_and_get_bitmap(group_index, 1);
+}
+
+/* four corners, around */
+static void hud_port_quad(
+	real_point2d const *points,
+	pixel32 const *colors)
+{
+	struct bitmap_data *map = hud_port_white_bitmap();
+	struct rasterizer_dynamic_screen_geometry_parameters parameters;
+	struct dynamic_screen_vertex vertices[4];
+	short vertex_index;
+
+	if (!map)
+		return;
+	for (vertex_index = 0; vertex_index<4; vertex_index++)
+	{
+		vertices[vertex_index].position = points[vertex_index];
+		vertices[vertex_index].texture_coordinates.x = 0.5f;
+		vertices[vertex_index].texture_coordinates.y = 0.5f;
+		vertices[vertex_index].color = colors[vertex_index];
+	}
+	csmemset(&parameters, 0, sizeof(parameters));
+	parameters.map_texture_scale[0].i = 1.0f;
+	parameters.map_texture_scale[0].j = 1.0f;
+	parameters.map_scale[0].i = 1.0f;
+	parameters.map_scale[0].j = 1.0f;
+	parameters.framebuffer_blend_function = _shader_framebuffer_blend_function_alpha_blend;
+	parameters.map[0] = map;
+	rasterizer_psuedo_dynamic_screen_quad_draw(&parameters, vertices);
+
+	return;
+}
+
+static void hud_port_rectangle(
+	real x,
+	real y,
+	real width,
+	real height,
+	pixel32 color)
+{
+	real_point2d points[4];
+	pixel32 colors[4];
+
+	points[0].x = x; points[0].y = y;
+	points[1].x = x+width; points[1].y = y;
+	points[2].x = x+width; points[2].y = y+height;
+	points[3].x = x; points[3].y = y+height;
+	colors[0] = colors[1] = colors[2] = colors[3] = color;
+	hud_port_quad(points, colors);
+
+	return;
+}
+
+/* a ring around (x, y), radius and thickness in pixels */
+static void hud_port_ring(
+	real x,
+	real y,
+	real radius,
+	real thickness,
+	pixel32 color,
+	short segment_count)
+{
+	short index;
+
+	for (index = 0; index<segment_count; index++)
+	{
+		real a0 = (2.0f*_pi)*index/segment_count;
+		real a1 = (2.0f*_pi)*(index+1)/segment_count;
+		real inner = radius-thickness/2, outer = radius+thickness/2;
+		real_point2d points[4];
+		pixel32 colors[4];
+
+		points[0].x = x+(real)cos(a0)*inner; points[0].y = y+(real)sin(a0)*inner;
+		points[1].x = x+(real)cos(a0)*outer; points[1].y = y+(real)sin(a0)*outer;
+		points[2].x = x+(real)cos(a1)*outer; points[2].y = y+(real)sin(a1)*outer;
+		points[3].x = x+(real)cos(a1)*inner; points[3].y = y+(real)sin(a1)*inner;
+		colors[0] = colors[1] = colors[2] = colors[3] = color;
+		hud_port_quad(points, colors);
+	}
+
+	return;
+}
+
+void hud_port_radar_sweep(
+	short local_player_index,
+	point2d const *center,
+	real radius_units)
+{
+	static unsigned long changes = 0;
+	static boolean read = FALSE;
+	static boolean enabled = FALSE;
+	real s, r, x, y;
+	real line;
+	real theta;
+	short slice;
+	short part = hud_port_part;
+
+	if (!read || changes!=config_changes())
+	{
+		read = TRUE;
+		changes = config_changes();
+		enabled = config_boolean("hud.radar_sweep")!=0;
+	}
+	if (!enabled || !center)
+		return;
+	s = hud_globals_get_scale(local_player_count()>1);
+	if (s<=0.0f)
+		s = 1.0f;
+	if (radius_units<15.0f || radius_units>120.0f)
+		radius_units = 46.0f;
+	r = radius_units*s;
+	x = (real)center->x;
+	y = (real)center->y;
+	line = MAX(1.0f, 0.9f*s);
+	hud_port_part = _hud_port_part_none;
+
+	/* the sweep: a fan behind its edge, fading, a turn every three seconds */
+	theta = (2.0f*_pi)*(real)(game_time_get()%90)/90.0f;
+	for (slice = 0; slice<6; slice++)
+	{
+		real a0 = theta-0.12f*slice, a1 = theta-0.12f*(slice+1);
+		real_point2d points[4];
+		pixel32 colors[4];
+
+		points[0].x = x; points[0].y = y;
+		points[1].x = x+(real)cos(a0)*r; points[1].y = y+(real)sin(a0)*r;
+		points[2].x = x+(real)cos(a1)*r; points[2].y = y+(real)sin(a1)*r;
+		points[3].x = x; points[3].y = y;
+		colors[0] = colors[3] = hud_port_color(0.30f*(1.0f-slice/6.0f), HUD_PORT_ACCENT);
+		colors[1] = colors[2] = hud_port_color(0.42f*(1.0f-slice/6.0f), HUD_PORT_ACCENT);
+		hud_port_quad(points, colors);
+	}
+
+	/* the cross and the rings */
+	hud_port_rectangle(x-r, y-line/2, 2*r, line, hud_port_color(0.2f, HUD_PORT_ACCENT));
+	hud_port_rectangle(x-line/2, y-r, line, 2*r, hud_port_color(0.2f, HUD_PORT_ACCENT));
+	hud_port_ring(x, y, r*0.5f, line, hud_port_color(0.3f, HUD_PORT_ACCENT), 16);
+	hud_port_ring(x, y, r, 1.5f*line, hud_port_color(0.75f, HUD_PORT_ACCENT), 24);
+	hud_port_part = part;
+
+	return;
+}
