+/* port: where the player has moved the parts of the HUD (settings, TRUCOS, HUD):
+hud.<part>_x and hud.<part>_y plus the fine ones, hud.<part>_fx and hud.<part>_fy, in HUD
+units, read again when a setting changes.
+They move the part whatever corner it is anchored to: positive x is right and
+positive y is down */
+long config_integer(const char *name);
+unsigned long config_changes(void);
+
+short hud_port_part = _hud_port_part_none;
+
+static real hud_port_offset(
+	short part,
+	short axis)
+{
+	static char const *const names[NUMBER_OF_HUD_PORT_PARTS][4] =
+	{
+		{ NULL, NULL, NULL, NULL },
+		{ "hud.shield_x", "hud.shield_y", "hud.shield_fx", "hud.shield_fy" },
+		{ "hud.health_x", "hud.health_y", "hud.health_fx", "hud.health_fy" },
+		{ "hud.radar_x", "hud.radar_y", "hud.radar_fx", "hud.radar_fy" },
+		{ "hud.ammo_x", "hud.ammo_y", "hud.ammo_fx", "hud.ammo_fy" },
+		{ "hud.grenades_x", "hud.grenades_y", "hud.grenades_fx", "hud.grenades_fy" },
+	};
+	static real offsets[NUMBER_OF_HUD_PORT_PARTS][2];
+	static unsigned long changes = 0;
+	static boolean read = FALSE;
+	real result = 0.0f;
+
+	if (part>0 && part<NUMBER_OF_HUD_PORT_PARTS && axis>=0 && axis<2)
+	{
+		if (!read || changes!=config_changes())
+		{
+			short part_index, axis_index;
+
+			read = TRUE;
+			changes = config_changes();
+			for (part_index = 1; part_index<NUMBER_OF_HUD_PORT_PARTS; part_index++)
+			{
+				for (axis_index = 0; axis_index<2; axis_index++)
+				{
+					long value = config_integer(names[part_index][axis_index])+
+						config_integer(names[part_index][axis_index+2]);
+
+					offsets[part_index][axis_index] = (real)PIN(value, -2000, 2000);
+				}
+			}
+		}
+		result = offsets[part][axis];
+	}
+
+	return result;
+}
