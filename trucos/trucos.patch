+/* port: a cheat that is done once when the player turns it on in the settings
+(the weapons, vehicles and powerups near the player, the camouflage). It is put
+back to off at once, so it works as a button; `done` keeps it from being done
+again every tick should the setting not be written back */
+struct cheat_action_setting
+{
+	char const *name;
+	void (*action)(void);
+	boolean done;
+};
+
+static struct cheat_action_setting cheat_action_settings[] =
+{
+	{ "cheats.all_weapons", cheat_all_weapons, FALSE },
+	{ "cheats.all_vehicles", cheat_port_all_vehicles, FALSE },
+	{ "cheats.all_powerups", cheat_port_all_powerups, FALSE },
+	{ "cheats.active_camouflage", cheat_active_camouflage, FALSE },
+};
+
+#define NUMBER_OF_CHEAT_ACTION_SETTINGS (sizeof(cheat_action_settings)/sizeof(cheat_action_settings[0]))
+
+#define NUMBER_OF_CHEAT_SETTINGS (sizeof(cheat_settings)/sizeof(cheat_settings[0]))
+
+/* the settings read again when one changed (config_changes), or when a map
+starts (force) */
+static unsigned long cheat_settings_changes = 0;
+static boolean cheat_settings_read = FALSE;
+
+static void cheats_settings_apply(
+	boolean force)
+{
+	unsigned long changes = config_changes();
+	boolean own_game = game_connection()==_game_connection_local && !network_game_distributed_client();
+	short index;
+
+	if (force || !cheat_settings_read || changes!=cheat_settings_changes)
+	{
+		cheat_settings_read = TRUE;
+		cheat_settings_changes = changes;
+		for (index = 0; index<(short)NUMBER_OF_CHEAT_SETTINGS; index++)
+		{
+			struct cheat_setting *setting = cheat_settings + index;
+			boolean wanted = config_boolean(setting->name)!=0;
+
+			if (setting->wanted && !wanted)
+				setting->clear = TRUE;
+			setting->wanted = wanted;
+		}
+	}
+
+	for (index = 0; index<(short)NUMBER_OF_CHEAT_SETTINGS; index++)
+	{
+		struct cheat_setting *setting = cheat_settings + index;
+
+		if (own_game)
+		{
+			if (setting->wanted)
+				*setting->state = TRUE;
+			else if (setting->clear)
+				*setting->state = FALSE;
+		}
+		setting->clear = FALSE;
+	}
+
+	for (index = 0; index<(short)NUMBER_OF_CHEAT_ACTION_SETTINGS; index++)
+	{
+		struct cheat_action_setting *action = cheat_action_settings + index;
+
+		if (own_game && config_boolean(action->name))
+		{
+			if (!action->done)
+			{
+				action->done = TRUE;
+				action->action();
+				config_write_boolean(action->name, 0);
+			}
+		}
+		else if (!config_boolean(action->name))
+		{
+			action->done = FALSE;
+		}
+	}
+
+	return;
+}
