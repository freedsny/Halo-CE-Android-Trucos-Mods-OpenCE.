+static long touch_hud_round(float value, long step)
+{
+	float steps = value / step;
+
+	return (long)(steps < 0.0f ? steps - 0.5f : steps + 0.5f) * step;
+}
+
+static void touch_hud_write(const char *name, long value)
+{
+	char text[16];
+	int length = 0;
+	unsigned long magnitude = (unsigned long)(value < 0 ? -value : value);
+	char digits[12];
+	int count = 0;
+
+	do
+	{
+		digits[count++] = (char)('0' + magnitude % 10);
+		magnitude /= 10;
+	} while (magnitude && count < (int)sizeof(digits));
+	if (value < 0)
+		text[length++] = '-';
+	while (count)
+		text[length++] = digits[--count];
+	text[length] = 0;
+	config_write(name, text);
+}
+
+static void touch_hud_editor(void)
+{
+	static const char *const names[TOUCH_HUD_PARTS][4] =
+	{
+		{ "hud.shield_x", "hud.shield_y", "hud.shield_fx", "hud.shield_fy" },
+		{ "hud.health_x", "hud.health_y", "hud.health_fx", "hud.health_fy" },
+		{ "hud.radar_x", "hud.radar_y", "hud.radar_fx", "hud.radar_fy" },
+		{ "hud.ammo_x", "hud.ammo_y", "hud.ammo_fx", "hud.ammo_fy" },
+		{ "hud.grenades_x", "hud.grenades_y", "hud.grenades_fx", "hud.grenades_fy" },
+	};
+	static float sent[TOUCH_HUD_PARTS * 4];
+	static int sent_known;
+	float rects[TOUCH_HUD_PARTS * 4];
+	float view_units[2];
+	float deltas[TOUCH_HUD_PARTS * 2];
+	float preview[TOUCH_HUD_PARTS * 2];
+	int part, axis;
+
+	if (host_touch_hud_moves(deltas) && hud_port_touch_rects(rects, view_units))
+	{
+		for (part = 0; part < TOUCH_HUD_PARTS; part++)
+		{
+			float moved[2] = { 0.0f, 0.0f };
+
+			for (axis = 0; axis < 2; axis++)
+			{
+				float delta = deltas[part * 2 + axis];
+				long old_total, total, coarse, fine;
+
+				if (delta == 0.0f || view_units[axis] <= 0.0f)
+					continue;
+				old_total = config_integer(names[part][axis]) + config_integer(names[part][axis + 2]);
+				total = old_total + touch_hud_round(delta * view_units[axis], 1);
+				coarse = touch_hud_round((float)total, 100);
+				coarse = coarse < -1000 ? -1000 : coarse > 1000 ? 1000 : coarse;
+				fine = touch_hud_round((float)(total - coarse), 5);
+				fine = fine < -50 ? -50 : fine > 50 ? 50 : fine;
+				touch_hud_write(names[part][axis], coarse);
+				touch_hud_write(names[part][axis + 2], fine);
+				moved[axis] = (coarse + fine - old_total) / view_units[axis];
+			}
+			/* (the part shown where it goes until the HUD draws it there) */
+			hud_port_touch_shift((short)(part + 1), moved[0], moved[1]);
+		}
+	}
+	/* (where a finger drags a part, drawn there before Save; read after the
+	moves, which end it) */
+	host_touch_hud_preview(preview);
+	if (hud_port_touch_rects(rects, view_units))
+	{
+		for (part = 0; part < TOUCH_HUD_PARTS; part++)
+			hud_port_touch_preview((short)(part + 1), preview[part * 2] * view_units[0],
+				preview[part * 2 + 1] * view_units[1]);
+	}
+	if (hud_port_touch_rects(rects, view_units) &&
+		(!sent_known || memcmp(rects, sent, sizeof(rects))))
+	{
+		memcpy(sent, rects, sizeof(sent));
+		sent_known = 1;
+		host_touch_hud(rects, TOUCH_HUD_PARTS);
+	}
+}
