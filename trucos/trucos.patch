+# Network Setup's cheats (source/game/cheats.c): each is on for every tick of
+# a game that is not on a network, and set or cleared at once when changed (in
+# a game too: the pause menu's SETTINGS)
+# TRUCOS (the About item of the SETTINGS list: port/linux/game/menu_tags.c and
+# trucos/regenerar_menus.py): its screens are the cheats' (source/game/cheats.c:
+# each is on for every tick of a game that is not on a network, and set or
+# cleared at once when changed, in a game too), the one-time ones' (put back to
+# off by the game: they work as buttons), and where the HUD's parts are
+# (source/interface/hud_draw.c: hud.<part>_x and hud.<part>_y)
+HUD_STEPS = list(range(-1000, 1001, 100))
+HUD_FINE_STEPS = list(range(-50, 51, 5))
+HUD_VALUES = [(f"{step:+d}" if step else "0", str(step)) for step in HUD_STEPS]
+HUD_FINE_VALUES = [(f"{step:+d}" if step else "0", str(step)) for step in HUD_FINE_STEPS]
+
+
+def _hud_rows(part: str, name: str, help_text: str) -> list:
+    # each axis has a coarse row (by 100) and a fine one (by 5, added to it): 625
+    # is 600 and +25
+    rows = []
+    for axis, label, more in (("x", "HORIZONTAL", "Mas = derecha, menos = izquierda."),
+                              ("y", "VERTICAL", "Mas = abajo, menos = arriba.")):
+        rows.append((f"{name} {label}:", f"hud.{part}_{axis}", HUD_VALUES,
+                     f"{help_text} De 100 en 100.\\n{more} 0: original.", None))
+        rows.append((f"{name} {label} FINO:", f"hud.{part}_f{axis}", HUD_FINE_VALUES,
+                     f"Ajuste fino de 5 en 5, se suma al anterior.\\nAsi 625 es 600 y +25.", None))
+    return rows
+
