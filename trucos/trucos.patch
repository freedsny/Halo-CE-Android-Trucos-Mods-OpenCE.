+            }
+            hudTabs[at] = tabLeft;
+            hudTabs[at + 1] = tabTop;
+            hudTabs[at + 2] = tabLeft + tabWidth;
+            hudTabs[at + 3] = tabTop + HUD_TAB_HEIGHT;
+        }
+    }
