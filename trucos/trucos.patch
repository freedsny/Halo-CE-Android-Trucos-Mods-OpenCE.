+/* the parts' rectangles into rects[20]; returns their count of changes (0
+before the game has drawn its HUD) */
+JNIEXPORT jint JNICALL Java_com_halo_decomp_TouchControls_nativeHudRects(JNIEnv *env, jclass cls,
+	jfloatArray rects)
+{
+	float copy[TOUCH_HUD_PARTS * 4];
+	int serial;
+
+	(void)cls;
+	pthread_mutex_lock(&touch_lock);
+	memcpy(copy, touch_hud_rects, sizeof(copy));
+	serial = touch_hud_serial;
+	pthread_mutex_unlock(&touch_lock);
+	if (rects && (*env)->GetArrayLength(env, rects) >= TOUCH_HUD_PARTS * 4)
+		(*env)->SetFloatArrayRegion(env, rects, 0, TOUCH_HUD_PARTS * 4, (const jfloat *)copy);
