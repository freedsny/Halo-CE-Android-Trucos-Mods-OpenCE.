+/* the editor's Save: how far each part moved (x, y as fractions of the
+screen), added to what the game has not read yet */
+JNIEXPORT void JNICALL Java_com_halo_decomp_TouchControls_nativeHudMove(JNIEnv *env, jclass cls,
+	jfloatArray deltas)
+{
+	float copy[TOUCH_HUD_PARTS * 2];
+	int index;
+
+	(void)cls;
+	if (!deltas || (*env)->GetArrayLength(env, deltas) < TOUCH_HUD_PARTS * 2)
+		return;
+	(*env)->GetFloatArrayRegion(env, deltas, 0, TOUCH_HUD_PARTS * 2, (jfloat *)copy);
+	pthread_mutex_lock(&touch_lock);
+	for (index = 0; index < TOUCH_HUD_PARTS * 2; index++)
+		touch_hud_moves[index] += copy[index];
+	touch_hud_moves_waiting = 1;
+	pthread_mutex_unlock(&touch_lock);
+}
