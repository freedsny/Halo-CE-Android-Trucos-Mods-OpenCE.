+		memcpy(deltas, touch_hud_moves, sizeof(touch_hud_moves));
+		memset(touch_hud_moves, 0, sizeof(touch_hud_moves));
+		touch_hud_moves_waiting = 0;
+		memset(touch_hud_preview, 0, sizeof(touch_hud_preview));
+	}
+	pthread_mutex_unlock(&touch_lock);
+	return waiting;
