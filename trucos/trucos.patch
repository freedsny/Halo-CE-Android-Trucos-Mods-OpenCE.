+    // ---------- the HUD's parts, moved in the editor (port/linux/src/touch_input.c)
+
+    private static boolean isHudPart(int target) {
+        return target <= HUD_PART && target > HUD_PART - HUD_PARTS;
+    }
+
+    /** where the game drew them: read while the editor is open */
+    private void readHud() {
+        if (!editing)
+            return;
+        int serial = nativeHudRects(hudRectsRead);
+        if (serial == 0 || serial == hudSerial)
+            return;
+        hudSerial = serial;
+        if (!Arrays.equals(hudRectsRead, hudRects)) {
+            System.arraycopy(hudRectsRead, 0, hudRects, 0, hudRects.length);
+            invalidate();
+        }
+    }
+
+    private boolean hudKnown(int part) {
+        return hudRects[part * 4] >= -0.5f && hudRects[part * 4 + 2] > hudRects[part * 4];
+    }
+
+    /** a part's box in logical units, where the editor has it: at least HUD_MINIMUM_BOX */
+    private float hudWidth(int part) {
+        return Math.max(HUD_MINIMUM_BOX, (hudRects[part * 4 + 2] - hudRects[part * 4]) * logicalWidth);
+    }
+
+    private float hudHeight(int part) {
+        return Math.max(HUD_MINIMUM_BOX, (hudRects[part * 4 + 3] - hudRects[part * 4 + 1]) * logicalHeight);
+    }
+
+    private float hudLeft(int part) {
+        float drawn = (hudRects[part * 4] + hudRects[part * 4 + 2]) / 2 * logicalWidth;
+        return drawn + hudMoves[part * 2] * logicalWidth - hudWidth(part) / 2;
+    }
+
+    private float hudTop(int part) {
+        float drawn = (hudRects[part * 4 + 1] + hudRects[part * 4 + 3]) / 2 * logicalHeight;
+        return drawn + hudMoves[part * 2 + 1] * logicalHeight - hudHeight(part) / 2;
+    }
+
+    /** the part under a point (logical units), the smallest first (the radar holds no other) */
+    private int hitHud(float x, float y) {
+        layoutHudTabs();
+        for (int part = 0; part < HUD_PARTS; part++) {
+            if (!Float.isNaN(hudTabs[part * 4]) && x >= hudTabs[part * 4] && x <= hudTabs[part * 4 + 2]
+                    && y >= hudTabs[part * 4 + 1] && y <= hudTabs[part * 4 + 3])
+                return HUD_PART - part;
+        }
+        int found = NOTHING;
+        float area = Float.MAX_VALUE;
+        for (int part = 0; part < HUD_PARTS; part++) {
